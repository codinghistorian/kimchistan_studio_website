    "kind": "text",
    "top": 190.0,
    "bottom": 199.0,
    "text": "기능 영역"
  },
  {
    "page": 2,
    "kind": "text",
    "top": 190.0,
    "bottom": 199.0,
    "text": "유지·전환 기준"
  },
  {
    "page": 2,
    "kind": "text",
    "top": 190.0,
    "bottom": 199.0,
    "text": "주요 확인 항목"
  },
