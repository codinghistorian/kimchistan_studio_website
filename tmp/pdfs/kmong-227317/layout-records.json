    "kind": "paragraph",
    "top": 394.0,
    "bottom": 409.0,
    "text": "기존 파일 처리 방식 연동"
  },
  {
    "page": 2,
    "kind": "paragraph",
    "top": 394.0,
    "bottom": 409.0,
